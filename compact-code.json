tionary Comprehensions","html_id":"id-2-2-1-list-set-and-dictionary-comprehensions","implicit":true,"key":"V66H5hsAav"},{"type":"code","lang":"python","value":"# List comprehension with a condition\nl = [i for i in range(11) if i%2==0]\nprint(l)\n\n# Or even simpler\nl = [i*2 for i in range(6)]\nprint(l)","position":{"start":{"line":74,"column":1},"end":{"line":82,"column":1}},"key":"BsisqZ66Jw"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"We can also add conditions to comprehensions:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"uVB0TzIaFI"}],"key":"E9oGjx9fZy"},{"type":"code","lang":"python","value":"# List comprehension with a condition\nl = [i for i in range(11) if i%2==0]\nprint(l)\n\n# Another example\nwords = ['zero','one','two','three','four','five','six','seven','eight','nine','ten']\nl = [i if i%4==0 else words[i] for i in range(11) if i%2==0]\nprint(l)\n\n# Example using set comprehension\ns = {i%3 for i in range(30)}\nprint(s)\n\n# Example using dictionary comprehension\nd = {i:words[i] for i in range(11) if i%2==0}\nprint(d)\n\n# Another example using dictionary comprehension\nnums = [i for i in range(11)]\nd = {word:num for word,num in zip(words,nums)}\nprint('d =',d)\nd_even = {word:num for word,num in d.items() if num%2==0}\nprint('d_even =',d_even)\n","position":{"start":{"line":86,"column":1},"end":{"line":111,"column":1}},"key":"VwSykLWZFx"},{"type":"heading","depth":3,"position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"2.2.2 Generator Expressions","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"zYAGJaCMwn"}],"identifier":"id-2-2-2-generator-expressions","label":"2.2.2 Generator Expressions","html_id":"id-2-2-2-generator-expressions","implicit":true,"key":"b3DqDJlhYe"},{"type":"paragraph","position":{"start":{"line":115,"column":1},"end":
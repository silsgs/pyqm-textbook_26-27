t using one-line if-else\nprint('a is greater than b' if a>b else 'a is not greater than b') # however here we are not storing the result in a variable\n","key":"OP52f7iYku"},{"type":"outputs","id":"MgbfvUeSKNwfvX8XLkAdy","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"a is not greater than b\nmax_value = 20\na is not greater than b\n"},"children":[],"key":"HfmBphd0xd"}],"key":"R1bJMaN3wp"}],"key":"Gyu2nLyExO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We can even do this with more complicated conditional structures:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g7jGuHtSXv"}],"key":"VJ6BXKIsYX"}],"key":"DmIai5RViR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"if a < b:\n    c='less than'\nelif a>b:\n    c='greater than'\nelse:\n    c='equal to'\n    \nprint('a is', c, 'b')\n\n# Using one-line if-elif-else\nprint('a is', 'less than' if a<b else 'greater than' if a>b else 'equal to', 'b') # again here we won't be storing the result in a variable\n","key":"Eu6XejMRQO"},{"type":"outputs","id":"RSFGOoQeCAuAN4GUQU1nQ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"a is less than b\na is less than b\n"},"children":[],"key":"JAwaWSNz3k"}],"key":"hKhz1Q6AbX"}],"key":"cJcz9irxbC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2.1.2 One-Line For Loops","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tcIouR5xxp"}],"identifier":"id-2-1-2-one-line-for-loops","label":"2.1.2 One-Line For Loops","html_id":"id-2-1-2-one-line-for-loops","implicit":true,"key":"nmkialhUqT"},{"type":"paragraph","po
t\nfor value in gen:\n    print(value)  # This will print each value generated\n","key":"z7OVtz59M5"},{"type":"outputs","id":"xDIZU8_u2mQ_uM29ISoRs","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<generator object <genexpr> at 0x00000220DA7AC7B0>\n0\n2\n4\n6\n8\n10\n"},"children":[],"key":"esC14zcsbK"}],"key":"f7SSDnDrJB"}],"key":"OwOfpTzpWa"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Instead of an iterable containing all of it’s elements generators distinguish themselves by storing the information to generate elements. For instance, the function ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DuyhJpVoy7"},{"type":"inlineCode","value":"range()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i8wyiLzZIm"},{"type":"text","value":" is a generator. We can make our own generators with a similar sintax to what is used in comprehensions except now with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JlYIhSWfz7"},{"type":"inlineCode","value":"()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Gb4BIWvWM8"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NXvYffwk9d"}],"key":"fgKHfe9nhi"}],"key":"bd1oAEwMED"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"gen = (i*2 for i in range(6))\nprint(gen)  # This will print the generator object\nfor value in gen:\n    print(value)  # This will print each value generated","key":"HVyaFLRmQ0"},{"type":"outputs","id":"TWZ4vHBm1dtdk1w_Fv8OK","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<generator object <genexpr> at 0x00000220DA7ACEB0>\n0\n2\n4\n6\n8\n10\n"},"children":[],"k
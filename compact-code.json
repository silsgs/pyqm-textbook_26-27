admonitionTitle","children":[{"type":"text","value":"Solution","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ZyNuczgbZd"}],"key":"cVtMEkzw58"},{"type":"code","lang":"python","value":"# 1. List comprehension for the first 10 square numbers\nsquares_list = [x**2 for x in range(1, 11)]\nprint(squares_list)\n\n# 2. Generator expression for the first 10 square numbers\nsquares_gen = (x**2 for x in range(1, 11))\nprint(list(squares_gen))\n\n# 3. Function that returns a generator for even numbers\ndef even_numbers(numbers):\n    return (x for x in numbers if x % 2 == 0)\n\nnumbers = list(range(1, 11))\neven_gen = even_numbers(numbers)\nprint(list(even_gen))","position":{"start":{"line":8,"column":1},"end":{"line":23,"column":1}},"key":"yJeoi76PJe"}],"class":"dropdown","key":"ZZDXYpLVgj"}],"key":"XwmbwbvSXB"}],"key":"j2vInL2gyd"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Part 1. Algorithm and Flow control with Python","url":"/flow-control","group":"Course content"},"next":{"title":"Part 3. Working with external data and files in Python","url":"/external-data","group":"Course content"}}},"domain":"http://localhost:3000"}
t\nfor value in gen:\n    print(value)  # This will print each value generated\n","key":"sxoL6sXPAQ"},{"type":"outputs","id":"e8BXty9LchpfXUN84dcXw","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<generator object <genexpr> at 0x00000220DA7AC7B0>\n0\n2\n4\n6\n8\n10\n"},"children":[],"key":"Uf8X63tbrx"}],"key":"Upej1Qirh5"}],"key":"XW2cRMtixG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Instead of an iterable containing all of it’s elements generators distinguish themselves by storing the information to generate elements. For instance, the function ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DpwtuKyb6O"},{"type":"inlineCode","value":"range()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mO7plMVZP2"},{"type":"text","value":" is a generator. We can make our own generators with a similar sintax to what is used in comprehensions except now with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SQBjmW7HqF"},{"type":"inlineCode","value":"()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OD5Ge0RPj2"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rSzvo84ETJ"}],"key":"HqGptcUg8W"}],"key":"eYdbkTw6XK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"gen = (i*2 for i in range(6))\nprint(gen)  # This will print the generator object\nfor value in gen:\n    print(value)  # This will print each value generated","key":"q9Caz1ok05"},{"type":"outputs","id":"FNySQ658qd1beGBrYQLMX","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<generator object <genexpr> at 0x00000220DA7ACEB0>\n0\n2\n4\n6\n8\n10\n"},"children":[],"k
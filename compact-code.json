t\nfor value in gen:\n    print(value)  # This will print each value generated\n","key":"NDFtm7gEyR"},{"type":"outputs","id":"Q9UbVg_y3tRBdA9u_vEHV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<generator object <genexpr> at 0x00000220DA7AC7B0>\n0\n2\n4\n6\n8\n10\n"},"children":[],"key":"KitqMnhfee"}],"key":"kuCMwzFnqs"}],"key":"gIGEhGDtlT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Instead of an iterable containing all of it’s elements generators distinguish themselves by storing the information to generate elements. For instance, the function ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gM7kMH46w7"},{"type":"inlineCode","value":"range()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zzZg3Z8Y3u"},{"type":"text","value":" is a generator. We can make our own generators with a similar sintax to what is used in comprehensions except now with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"reqynItNrj"},{"type":"inlineCode","value":"()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oVpDmu5w1s"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ISYHjDRsia"}],"key":"nAzUOyeRzD"}],"key":"k15insVN93"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"gen = (i*2 for i in range(6))\nprint(gen)  # This will print the generator object\nfor value in gen:\n    print(value)  # This will print each value generated","key":"x7n12NPvFs"},{"type":"outputs","id":"uFMD3rNGYAztp8VGA8CUw","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<generator object <genexpr> at 0x00000220DA7ACEB0>\n0\n2\n4\n6\n8\n10\n"},"children":[],"key":"mt2PdkRSbN"}],"key":"N162LOhjIQ"}],"key":"TlXAzajsiF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Exercise on compact code and generators","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IGbJIhsQo8"}],"identifier":"exercise-on-compact-code-and-generators","label":"Exercise on compact code and generators","html_id":"exercise-on-compact-code-and-generators","implicit":true,"key":"MMfwJTAcdu"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Write a Python program that uses a list comprehension to generate a list of the first 10 square numbers.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"BuD7w5eGXd"}],"key":"ZVHpJgsGmP"}],"key":"ypOxWnMW7F"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Modify the program to use a generator expression instead of a list comprehension.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mLwxEJyLai"}],"key":"hp99EP2wrZ"}],"key":"b3QKc53wTq"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Write a function that takes a list of numbers and returns a generator that yields only the even numbers from the list.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"up55xvSuzG"}],"key":"NPUEckDbZY"}],"key":"qYrHvAsJgk"}],"key":"fH2PmMlCG4"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"WowX9dcA9G"}],"key":"MhsUAbu1Bn"},{"type":"code","lang":"python","value":"# 1. List comprehension for the first 10 square numbers\nsquares_list = [x**2 for x in range(1, 11)]\nprint(squares_list)\n\n# 2. Generator expression for the first 10 square numbers\nsquares_gen = (x**2 for x in range(1, 11))\nprint(list(squares_gen))\n\n# 3. Function that returns a generator for even numbers\ndef even_numbers(numbers):\n    return (x for x in numbers if x % 2 == 0)\n\nnumbers = list(range(1, 11))\neven_gen = even_numbers(numbers)\nprint(list(even_gen))","position":{"start":{"line":8,"column":1},"end":{"line":23,"column":1}},"key":"GbN2RQOXXr"}],"class":"dropdown","key":"zBRylWbRzD"}],"key":"S23f4IVgcr"}],"key":"hmnFlcGEoR"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Part 1. Algorithm and Flow control with Python","url":"/flow-control","group":"Course content"},"next":{"title":"Part 3. Working with external data and files in Python","url":"/external-data","group":"Course content"}}},"domain":"http://localhost:3000"}
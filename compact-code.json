ey":"Q7Q5iqgHK5"}],"key":"wiShvLr832"}],"key":"ifwNjYrjyc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Exercise on compact code and generators","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"c8ImKXVxam"}],"identifier":"exercise-on-compact-code-and-generators","label":"Exercise on compact code and generators","html_id":"exercise-on-compact-code-and-generators","implicit":true,"key":"zhouCju7Rq"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Write a Python program that uses a list comprehension to generate a list of the first 10 square numbers.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"b4BVLUJ4Jx"}],"key":"DSTb46q6m3"}],"key":"xXWJXb4Svt"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Modify the program to use a generator expression instead of a list comprehension.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mTOBxcoF7H"}],"key":"Lil93CT4wY"}],"key":"og0hab8UV2"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Write a function that takes a list of numbers and returns a generator that yields only the even numbers from the list.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ZRweOid99O"}],"key":"kjT8dpfJ1D"}],"key":"mJU4gsGuyI"}],"key":"HUU5D3gfLS"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"XIf910WaXD"}],"key":"rMKMwYhAAo"},{"type":"code","lang":"python","value":"# 1. List comprehension for the first 10 square numbers\nsquares_list = [x**2 for x in range(1, 11)]\nprint(squares_list)\n\n# 2. Generator expression for the first 10 square numbers\nsquares_gen = (x**2 for x in range(1, 11))\nprint(list(squares_gen))\n\n# 3. Function that returns a generator for even numbers\ndef even_numbers(numbers):\n    return (x for x in numbers if x % 2 == 0)\n\nnumbers = list(range(1, 11))\neven_gen = even_numbers(numbers)\nprint(list(even_gen))","position":{"start":{"line":8,"column":1},"end":{"line":23,"column":1}},"key":"QZRmVMg2MS"}],"class":"dropdown","key":"n8AgjhSzdS"}],"key":"csJZGyRAW6"}],"key":"BCTHzu1V5Z"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Part 1. Algorithm and Flow control with Python","url":"/flow-control","group":"Course content"},"next":{"title":"Part 3. Working with external data and files in Python","url":"/external-data","group":"Course content"}}},"domain":"http://localhost:3000"}
{"version":3,"kind":"Notebook","sha256":"cf5aff971a2981a62d19df4669eb7a2dea6dc23dcce3e1571432710f0934e13e","slug":"importing-libs","location":"/04_all/04_00-importing-libs.ipynb","dependencies":[],"frontmatter":{"title":"Part 0. Importng Python Libraries","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"github":"https://github.com/silsgs/pyqm-textbook_26-27","numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"04_00-importing-libs.ipynb","url":"/pyqm-textbook_26-27/build/04_00-importing-libs-b48a64a2c2576d05c2e8a124bddbb066.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","data":{"cell_id":"00000-9d7b809c-0f50-4890-89d1-968ce40458c6","deepnote_cell_type":"markdown","id":"s3XFhs_4UD9P"},"children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"As we have seen in previous lectures, Python runs code in modules called libraries.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OBuXosiFzj"}],"key":"TCY0IkphR9"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Today we will explore three scientific computing libraries in Python: Numpy, Scipy, and Matplotlib. These libraries are widely used in data science, machine learning, and scientific computing for numerical computations, data manipulation, and visualization.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"AhzvpJzgNt"}],"key":"J5FPWH0HZX"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"There are some libraries that come pre-installed with Python, but many others need to be installed separately.\nThis is the case of all these three libraries. We need first to install, and then, import them in our code. ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Joi2wadfno"},{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Importing a library means making available all its functions and classes.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ja6jaw93mB"}],"key":"EPTO9apYtv"}],"key":"dBouUT7gK4"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"They are open-source and have extensive documentation and community support. They are also compatible with other popular Python libraries such as Pandas, Scikit-learn, and TensorFlow.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Vxw2xhyiJM"}],"key":"psz8y3ZSg8"},{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"0.1 Installing Libraries","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"QTrgUK2gau"}],"identifier":"id-0-1-installing-libraries","label":"0.1 Installing Libraries","html_id":"id-0-1-installing-libraries","implicit":true,"key":"cW5ZpxyD8u"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"We might have already installed these libraries if you are using the Anaconda environment we created the first week. But in case you need to install them, we can do so using conda or pip:","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"EVRPowvHab"}],"key":"iTWQ7TxsTU"},{"type":"code","lang":"bash","value":"conda install numpy scipy matplotlib\npip install numpy scipy matplotlib","position":{"start":{"line":15,"column":1},"end":{"line":18,"column":1}},"identifier":"s3xfhs_4ud9p-code","enumerator":"1","html_id":"s3xfhs-4ud9p-code","key":"NPFdiO4OvD"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"This applies to any other library you might want to install in the future. Just replace the library names with the ones you want to install.\nYou can also install specific versions of the libraries by specifying the version number. For example, to install version 1.21.0 of Numpy, you can use:","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"o5W7bMVdXb"}],"key":"L46W9uBi9I"},{"type":"code","lang":"bash","value":"### This is just an example\n# This code runs in the terminal, not in Python\nconda install numpy=1.21.0 scipy=1.7.0 matplotlib=3.4.2\n# or\npip install numpy==1.21.0 scipy==1.7.0 matplotlib==3.4.2","position":{"start":{"line":23,"column":1},"end":{"line":29,"column":1}},"key":"MrLK9GqXER"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"0.2 Importing Libraries","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"BLCj7cpK6r"}],"identifier":"id-0-2-importing-libraries","label":"0.2 Importing Libraries","html_id":"id-0-2-importing-libraries","implicit":true,"key":"egmeWmj95J"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Once the libraries are installed, since they are not included in the standard Python library, we always need to import them in our Python script or Jupyter Notebook using the following commands:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"HYsA4838HK"}],"key":"FRBqnPRZZ6"},{"type":"code","lang":"python","value":"# This code runs in Python\nimport numpy as np\nimport scipy as sp\nimport matplotlib.pyplot as plt","position":{"start":{"line":34,"column":1},"end":{"line":39,"column":1}},"key":"ktoFgdgDFY"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Here, we are importing Numpy as ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"qrfPuC6EVJ"},{"type":"inlineCode","value":"np","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"WG9h6eI1Ye"},{"type":"text","value":", Scipy as ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"hIs7PcUDbP"},{"type":"inlineCode","value":"sp","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"cPx6YuvGBj"},{"type":"text","value":", and Matplotlib’s ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"WTU73sfUKI"},{"type":"inlineCode","value":"pyplot","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"LHzgpnDqSC"},{"type":"text","value":" module as ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"QZjDonruJD"},{"type":"inlineCode","value":"plt","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"aT5s92N2LD"},{"type":"text","value":". This is a common convention in the Python community and makes it easier to use the libraries in our code.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"KAtJVhqm29"}],"key":"t2jsAamvq1"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"If you don’t load them in the beginning of your code, you will get an error when trying to use any of their functions or classes. The error will look like this:","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"YiT5pxfR0t"}],"key":"Wjv591lnOV"},{"type":"code","lang":"python","value":"NameError: name 'np' is not defined","position":{"start":{"line":45,"column":1},"end":{"line":47,"column":1}},"key":"cr6Aq6xlam"}],"identifier":"s3xfhs_4ud9p","label":"s3XFhs_4UD9P","html_id":"s3xfhs-4ud9p","key":"AyDXxPogXM"}],"key":"SGfZNrisaP"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Week 4","url":"/week4-intro","group":"Course content"},"next":{"title":"Part 1. Numpy for numerical computations","url":"/numpy-basics","group":"Course content"}}},"domain":"http://localhost:3000"}
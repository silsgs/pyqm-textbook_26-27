{"version":3,"kind":"Notebook","sha256":"27179ed03430c11cff98c56a7ddcd142fe8f2a95726de7fe554ac09e53f73d11","slug":"installation","location":"/06_all/06_00_installation.ipynb","dependencies":[],"frontmatter":{"title":"Part 0. Installation of QuTiP and Qiskit","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"PyQM","language":"python"},"github":"https://github.com/silsgs/pyqm-textbook_26-27","numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"06_00_installation.ipynb","url":"/pyqm-textbook_26-27/build/06_00_installation-d02ebcbd19afe2d9eb38f6bffa45b815.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"0.1 First steps","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jnFsRLfV18"}],"identifier":"id-0-1-first-steps","label":"0.1 First steps","html_id":"id-0-1-first-steps","implicit":true,"key":"tTRvezAIdb"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Two advanced libraries for quantum computing and quantum mechanics simulations in Python are QuTiP (Quantum Toolbox in Python) and Qiskit.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"waWLMJdfSB"}],"key":"Mj2c6vexlG"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Official websites","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"TG8RMf1uPz"}],"key":"jngdSXDUIB"}],"key":"H8cdv6TMaR"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"link","url":"https://qutip.org/","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"QuTiP","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"CARUkryk4R"}],"urlSource":"https://qutip.org/","key":"RXGL3kH5Lo"}],"key":"raIV5qUbGh"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"link","url":"https://quantum.cloud.ibm.com/docs/en/guides","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Qiskit","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"hjJBS8gJEb"}],"urlSource":"https://quantum.cloud.ibm.com/docs/en/guides","key":"LiPKRwrtFp"}],"key":"OK7Abxh3UN"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"We will first need to install them since they weren’t included in the environment we created on Week 1. To install both QuTiP and Qiskit, you can use pip or conda. As always, remember to activate the virtual environment dedicated to this course to avoid conflicts with other packages or projects.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"hNJ3EYgqsm"}],"key":"oKJTEXpQIY"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Open a terminal and run the following command:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"jkJCcSw8YR"}],"key":"YncHbLdcVc"},{"type":"code","lang":"bash","value":"conda activate pyqm\npip install qutip qiskit 'qiskit[visualization]' 'qiskit-ibm-runtime' 'qiskit-aer>=0.11.0'","position":{"start":{"line":17,"column":1},"end":{"line":20,"column":1}},"key":"cZCe4BSQUR"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"By running this command, pip will download and install the latest versions of QuTiP and Qiskit along with their dependencies.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"GgYpSmsxhL"}],"key":"kjGcKdBlaH"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"To check the versions of the installed packages, you can run the following commands on a terminal:","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"K0ikDnEnoI"}],"key":"mdTAfeqXmT"},{"type":"code","lang":"bash","value":"pip show qutip\npip show qiskit","position":{"start":{"line":26,"column":1},"end":{"line":29,"column":1}},"key":"chjzA660Lz"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Or you can check the versions directly in a Jupyter Notebook by running the following code:","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"U6yEiTDHge"}],"key":"U70CEyf46u"}],"key":"sejlRnYOpa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"\nimport qutip\nprint(\"QuTiP version:\", qutip.__version__)\n\nimport qiskit\nprint(\"Qiskit version:\", qiskit.__version__)\n\nimport numpy as np\nprint(\"Numpy version:\", np.__version__)\n\nimport scipy\nprint(\"Scipy version:\", scipy.__version__)\n\nimport matplotlib \nprint(\"Matplotlib version:\", matplotlib.__version__) # Matplotlib is not strictly required for QuTiP, but we will use it for visualization.\n\nimport sys  \nprint(\"Python version:\", sys.version)","key":"ca3osL5xV8"},{"type":"outputs","id":"gI_nnUVtMM9O5T7EY86RP","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"QuTiP version: 5.2.1\nQiskit version: 2.2.1\nNumpy version: 2.2.6\nScipy version: 1.15.2\nMatplotlib version: 3.9.4\nPython version: 3.10.19 | packaged by conda-forge | (main, Oct 13 2025, 14:22:43) [Clang 19.1.7 ]\n"},"children":[],"key":"tZ5LfoifRc"}],"key":"kVvxk18qPc"}],"key":"GILBlmrQa7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"0.2 Testing the installation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sNTNTsOGsU"}],"identifier":"id-0-2-testing-the-installation","label":"0.2 Testing the installation","html_id":"id-0-2-testing-the-installation","implicit":true,"key":"ErfhUaGOgf"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"0.2.1 QuTiP Test","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tgl855LBHp"}],"identifier":"id-0-2-1-qutip-test","label":"0.2.1 QuTiP Test","html_id":"id-0-2-1-qutip-test","implicit":true,"key":"rl6trWgII7"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"To test if QuTiP is working correctly, you can run a simple example from the QuTiP documentation. For instance, you can create a two-level quantum system (a qubit) and visualize its state on the Bloch sphere:","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Y79j3kByeg"}],"key":"LQ6W1AEnaS"}],"key":"XtG6yirhmc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom qutip import Bloch, basis\n\n# Create a Bloch sphere\nb = Bloch()\n\n# Define the basis states\nket_0 = basis(2, 0)\nket_1 = basis(2, 1)\n\n# Add the basis states to the Bloch sphere\nb.add_states([ket_0, ket_1])\n\n# Visualize the Bloch sphere\nb.show()\n\n","key":"CJdCshyJYU"},{"type":"outputs","id":"wHxXH4sMvAp4ypqlLwA_W","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"843ffa7202caa982cb2a2cf870de477d","path":"/pyqm-textbook_26-27/build/843ffa7202caa982cb2a2cf870de477d.png"},"text/plain":{"content":"<Figure size 500x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"O1h9FHy5C6"}],"key":"FM0gcRdI4V"}],"key":"fZ1JPxwYly"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"If the Bloch sphere is displayed correctly, then QuTiP is installed and working properly!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eCdXPHRsTi"}],"key":"idXzgkMClh"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"0.2.2 Qiskit Test","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nuep2mdzSG"}],"identifier":"id-0-2-2-qiskit-test","label":"0.2.2 Qiskit Test","html_id":"id-0-2-2-qiskit-test","implicit":true,"key":"R9Jd3r2CuZ"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"To test if Qiskit is working correctly, you can run a simple example that creates a quantum circuit and simulates it.\n(Source: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ZeVZPyqSLh"},{"type":"link","url":"https://pypi.org/project/qiskit/","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Qiskit installation","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"RzRvTAj9pp"}],"urlSource":"https://pypi.org/project/qiskit/","key":"Lb0bDr3XPa"},{"type":"text","value":")","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"rgXfSH2KAm"}],"key":"KT2J8ZdZho"}],"key":"Cck2lUONep"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nfrom qiskit import QuantumCircuit\n\n# 1. A quantum circuit for preparing the quantum state |000> + i |111> / √2\nqc = QuantumCircuit(3)\nqc.h(0)             # generate superposition\nqc.p(np.pi / 2, 0)  # add quantum phase\nqc.cx(0, 1)         # 0th-qubit-Controlled-NOT gate on 1st qubit\nqc.cx(0, 2)         # 0th-qubit-Controlled-NOT gate on 2nd qubit\n\n# 2. Define the observable to be measured \nfrom qiskit.quantum_info import SparsePauliOp\noperator = SparsePauliOp.from_list([(\"XXY\", 1), (\"XYX\", 1), (\"YXX\", 1), (\"YYY\", -1)])\n\n# 3. Execute using the Estimator primitive\nfrom qiskit.primitives import StatevectorEstimator\nestimator = StatevectorEstimator()\njob = estimator.run([(qc, operator)], precision=1e-3)\nresult = job.result()\nprint(f\" > Expectation values: {result[0].data.evs}\")","key":"pvg9uzxF4t"},{"type":"outputs","id":"W_thsCtA3OMWwkV2LBpy7","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" > Expectation values: 4.000564739515184\n"},"children":[],"key":"oDwsmvqVuo"}],"key":"Rz0PdKQNdI"}],"key":"BLRtiY6KZ0"}],"key":"E5lqnqwulN"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Week 6","url":"/week6-intro","group":"Course content"},"next":{"title":"Part 1. Introduction to Qiskit","url":"/qiskit","group":"Course content"}}},"domain":"http://localhost:3000"}